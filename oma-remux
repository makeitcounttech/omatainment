def _search_type(types, query, limit):
    _, _, uid = config()
    data = api("/Items?" + q(searchTerm=query, IncludeItemTypes=types, Recursive="true", Limit=limit,
                             userId=uid, Fields=FIELDS))
    return [card(i) for i in data.get("Items", []) if i.get("Type") == types]


def _relevance(item, query):
    title = (item.get("title") or "").lower()
    needle = query.strip().lower()
    return 0 if title == needle else 1 if title.startswith(needle) else 2


def search(kind, query):
    """Own type first; strong title matches of the other type follow (e.g. a show searched under Movies)."""
    primary = {"movie": "Movie", "series": "Series"}[kind]
    other = "Series" if primary == "Movie" else "Movie"
    own = _search_type(primary, query, 30)
    cross = [i for i in _search_type(other, query, 8) if _relevance(i, query) < 2][:3]
    exact_cross = [i for i in cross if _relevance(i, query) == 0]
    rest_cross = [i for i in cross if _relevance(i, query) != 0]
    exact_own = [i for i in own if _relevance(i, query) == 0]
    items = exact_own + exact_cross + [i for i in own if _relevance(i, query) != 0] + rest_cross
    return {"ok": True, "items": items}


def seasons(series_id):
