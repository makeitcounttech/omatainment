def continue_watching():
    _, _, uid = config()
    resume = api("/UserItems/Resume?" + q(userId=uid, Limit=20, MediaTypes="Video", Fields=FIELDS)).get("Items", [])
    nextup = api("/Shows/NextUp?" + q(userId=uid, Limit=20, Fields=FIELDS)).get("Items", [])
    seen, items = set(), []
    for item in resume + nextup:
        key = item.get("SeriesId") or item["Id"]
        if key not in seen:
            seen.add(key)
            items.append(card(item))
    return {"ok": True, "items": items}


