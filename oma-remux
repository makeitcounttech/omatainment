# ---------------------------------------------------------------- browse home

SORTS = {
    "featured": ("", ""),
    "rating": ("CommunityRating,SortName", "Descending"),
    "newest": ("PremiereDate,SortName", "Descending"),
    "az": ("SortName", "Ascending"),
}
GENRES = {
    "movie": ["Action", "Science Fiction", "Comedy", "Thriller", "Animation", "Horror", "Drama", "Crime", "Romance", "Documentary"],
    "series": ["Drama", "Crime", "Comedy", "Sci-Fi & Fantasy", "Mystery", "Animation", "Action & Adventure", "Documentary"],
}
ROW_PAGE = 24


def _views(kind):
    _, _, uid = config()
    want = "movies" if kind == "movie" else "tvshows"
    views = api(f"/Users/{uid}/Views").get("Items", [])
    lib = [v for v in views if v.get("CollectionType") == want]
    sets = api(f"/Users/{uid}/Items?" + q(IncludeItemTypes="BoxSet", Recursive="true", Limit=100)).get("Items", [])
    lib_ids = {v["Id"] for v in views}
    noun = "movie" if kind == "movie" else "show"
    extra = [s for s in sets if s["Id"] not in lib_ids and noun in s.get("Name", "").lower()]
    return lib, extra


def _row_specs(kind):
    lib, extra = _views(kind)
    item_type = "Movie" if kind == "movie" else "Series"
    everything = next((v for v in lib if v.get("Name") in ("Movies", "Shows")), None)
    specs = []
    order = {"trending": 0, "popular": 1}
    total_all = _count({"IncludeItemTypes": item_type})
    for view in sorted([v for v in lib if v is not everything],
                       key=lambda v: next((n for k, n in order.items() if k in v.get("Name", "").lower()), 5)):
        # Filter-based libraries that just mirror the whole library add nothing as a row.
        if _count({"IncludeItemTypes": item_type, "ParentId": view["Id"]}) >= total_all:
            continue
        specs.append({"id": f"parent:{view['Id']}", "title": view.get("Name", ""), "sort": "featured"})
    for box in extra:
        specs.append({"id": f"parent:{box['Id']}", "title": box.get("Name", ""), "sort": "featured"})
    specs.append({"id": f"all:{item_type}", "title": "Top rated", "sort": "rating"})
    specs.append({"id": f"all:{item_type}", "title": "New releases", "sort": "newest"})
    for genre in GENRES[kind]:
        specs.append({"id": f"genre:{genre}", "title": genre.replace("Science Fiction", "Sci-Fi"), "sort": "rating"})
    return specs


def _count(params):
    _, _, uid = config()
    data = api("/Items?" + q(userId=uid, Limit=0, Recursive="true", EnableTotalRecordCount="true", **params))
    return data.get("TotalRecordCount", 0)


def row(kind, row_id, sort="featured", start=0, limit=ROW_PAGE):
    _, _, uid = config()
    item_type = "Movie" if kind == "movie" else "Series"
    sort_by, order = SORTS.get(sort, SORTS["featured"])
    params = dict(userId=uid, Limit=limit, StartIndex=int(start), Fields=FIELDS, Recursive="true",
                  IncludeItemTypes=item_type, SortBy=sort_by or None, SortOrder=order or None,
                  EnableTotalRecordCount="true")
    source, _, value = row_id.partition(":")
    if source == "parent":
        params["ParentId"] = value
    elif source == "genre":
        params["Genres"] = value
    elif source != "all":
        raise RuntimeError(f"Unknown row {row_id}")
    # Remux ignores MinCommunityRating; for "New releases" skip placeholder entries
    # (no overview / the default 6.5 score) by over-fetching and filtering here.
    picky = sort == "newest" and source != "parent"
    if picky:
        params["Limit"] = limit * 4
    data = api("/Items?" + q(**params))
    raw = [i for i in data.get("Items", []) if i.get("Type") == item_type]
    if picky:
        raw = [i for i in raw if i.get("Overview") and (i.get("CommunityRating") or 0) > 6.6][:limit]
    items = [card(i) for i in raw]
    fetched = len(data.get("Items", []))
    return {"ok": True, "id": row_id, "sort": sort, "start": int(start), "items": items,
            "next": int(start) + fetched, "total": data.get("TotalRecordCount", len(items))}


def browse(kind):
    if kind not in ("movie", "series"):
        raise RuntimeError("kind must be movie or series")
    specs = _row_specs(kind)
    with ThreadPoolExecutor(max_workers=6) as pool:
        pages = list(pool.map(lambda spec: _safe_row(kind, spec), specs))
    want = "movie" if kind == "movie" else "episode"
    resume = [i for i in continue_watching()["items"] if i["type"] == want]
    rows = []
    if resume:
        rows.append({"id": "continue", "title": "Continue watching", "sort": "", "items": resume, "total": len(resume)})
    for spec, page in zip(specs, pages):
        if page and page["items"]:
            rows.append({**spec, "items": page["items"], "total": page["total"]})
    hero = next((i for r in rows if r["id"] != "continue" for i in r["items"] if i.get("backdrop") and i.get("overview")), None)
    return {"ok": True, "kind": kind, "rows": rows, "hero": hero, "quality": max_quality()}


def _safe_row(kind, spec):
    try:
        return row(kind, spec["id"], spec["sort"])
    except Exception:
        return None


def main(argv):
    command = argv[1] if len(argv) > 1 else "continue"
    args = argv[2:]
    try:
        if command == "search":
            result = search(args[0], args[1])
        elif command == "seasons":
            result = seasons(args[0])
        elif command == "episodes":
            result = episodes(args[0], args[1])
        elif command == "resolve":
            skip = []
            if "--skip" in args:
                at = args.index("--skip")
                skip = [x for x in (args[at + 1] if at + 1 < len(args) else "").split(",") if x]
                args = args[:at] + args[at + 2:]
            result = resolve(args[0].removeprefix("remux:"), args[1] if len(args) > 1 and args[1] else None, skip)
        elif command == "sources":
            result = sources(args[0].removeprefix("remux:"))
        elif command == "badsource":
            result = mark_bad(args[0].removeprefix("remux:"), args[1], args[2] if len(args) > 2 else "didn't play")
        elif command == "unplayed":
            result = unplayed(args[0].removeprefix("remux:"))
        elif command == "progress":
            result = progress(json.loads(args[0]))
        elif command == "stopped":
            result = stopped(json.loads(args[0]))
        elif command == "continue":
            result = continue_watching()
        elif command == "favorites":
            result = favorites()
        elif command == "favorite":
            result = favorite(args[0], args[1])
        elif command == "show":
            result = show(args[0].removeprefix("remux:"))
        elif command == "next":
            result = next_episode(args[0])
        elif command == "home":
            result = home()
        elif command == "browse":
            result = browse(args[0] if args else "movie")
        elif command == "row":
            result = row(args[0], args[1], args[2] if len(args) > 2 else "featured", args[3] if len(args) > 3 else 0)
        elif command == "share":
            result = share(args[0].removeprefix("remux:"))
        elif command == "handoff":
            result = handoff(args[0].removeprefix("remux:"), args[1] if len(args) > 1 else 0)
        elif command == "match":
            result = match(*(args + ["", "", "", "0"])[:4])
        elif command == "lookup":
            result = lookup(" ".join(args))
        elif command == "tiers":
            result = tiers(args[0])
        elif command == "quality":
            result = set_quality(args[0]) if args else {"ok": True, "quality": max_quality()}
        else:
            out({"ok": False, "error": f"Unknown command: {command}"})
            return 2
    except Exception as error:
        message = re.sub(r"api_key=[0-9a-f]+", "api_key=<hidden>", str(error) or error.__class__.__name__)
        out({"ok": False, "error": message})
        return 1
    out(result)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
