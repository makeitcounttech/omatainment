                "season": item.get("ParentIndexNumber"), "episodeId": item_id}
    if item.get("Type") == "Series":
        return {"ok": True, "item": card(item), "seasonId": "", "season": None, "episodeId": ""}
    return {"ok": False, "error": "Not part of a series"}


