#!/usr/bin/env python3
"""oma-video: video backend for OmaTainment (stdlib only).

Commands (all print one JSON object):
  resolve URL [--fresh]          playable loopback HLS source for the in-panel player
  prefetch URL                   warm the resolve cache in the background
  history                        continue-watching list, newest first
  history-update JSON            record {id,url,title,artist,position,length}
  history-remove ID
  pip URL TITLE ARTIST START     open the floating (pinned) mpv window at START seconds
  pip-pause | pip-close | pip-status
  youtube URL START              open the video in the default browser at START seconds
"""
import http.server
import json
import os
import re
import secrets
import signal
import socket
import subprocess
import sys
import threading
import time
import urllib.request
from pathlib import Path

STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "omatainment"
CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "omatainment" / "video"
HISTORY = STATE / "video_history.json"
PIP_SOCK = STATE / "pip.sock"
PIP_STATE = STATE / "pip.json"
SERVER_PID = STATE / "video_server.pid"
MAX_HEIGHT = 1080
CACHE_SECONDS = 2 * 3600
SERVER_IDLE_SECONDS = 15 * 60
FINISHED_MARGIN = 15
HISTORY_LIMIT = 60

STATE.mkdir(parents=True, exist_ok=True)
CACHE.mkdir(parents=True, exist_ok=True)


def out(obj):
    print(json.dumps(obj, separators=(",", ":")), flush=True)


def video_id(url):
    match = re.search(r"(?:v=|youtu\.be/|/shorts/|/live/)([A-Za-z0-9_-]{11})", url or "")
    if match:
        return match.group(1)
    return url if re.fullmatch(r"[A-Za-z0-9_-]{11}", url or "") else None


def watch_url(vid):
    return "https://www.youtube.com/watch?v=" + vid


def write_json(path, data):
    tmp = path.with_suffix(path.suffix + f".{os.getpid()}.tmp")
    tmp.write_text(json.dumps(data, separators=(",", ":")))
    os.replace(tmp, path)


def read_json(path, default):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return default


# ---------------------------------------------------------------- resolving

def extract(url, fresh=False):
    """Return {id,title,artist,duration,manifest,live} using a short-lived cache."""
    vid = video_id(url)
    if not vid:
        raise ValueError("Not a YouTube video URL")
    cache = CACHE / f"{vid}.json"
    if not fresh and cache.exists() and time.time() - cache.stat().st_mtime < CACHE_SECONDS:
        return read_json(cache, None) or extract(url, fresh=True)
    run = subprocess.run(
        ["yt-dlp", "-J", "--no-warnings", "--no-playlist", "--socket-timeout", "8", watch_url(vid)],
        capture_output=True, text=True, timeout=60,
    )
    if run.returncode != 0:
        message = (run.stderr.strip().splitlines() or ["yt-dlp failed"])[-1]
        raise RuntimeError(message.replace("ERROR: ", "")[:200])
    data = json.loads(run.stdout)
    manifest = next((f["manifest_url"] for f in data.get("formats", [])
                     if f.get("manifest_url") and "hls" in f.get("protocol", "") + f.get("manifest_url", "")), None)
    if not manifest:
        manifest = next((f["manifest_url"] for f in data.get("formats", []) if f.get("manifest_url")), None)
    if not manifest:
        raise RuntimeError("No streamable video format found")
    info = {
        "id": vid,
        "title": data.get("title") or "Unknown",
        "artist": data.get("channel") or data.get("uploader") or "",
        "duration": data.get("duration") or 0,
        "live": bool(data.get("is_live")),
        "language": data.get("language") or "",
        "manifest": manifest,
    }
    write_json(cache, info)
    return info


def pick_audio(renditions, language=None):
    """The video's original-language track, never a YouTube auto-dub.

    Auto-dubbed videos list ~20 renditions alphabetically (Arabic first) with no DEFAULT=YES, so taking the
    first one played a dub. Prefer NAME "... - original", then the video's language, then DEFAULT/AUTOSELECT,
    then any non-dubbed track.
    """
    if not renditions:
        return []
    def lang(r):
        m = re.search(r'LANGUAGE="([^"]+)"', r)
        return m.group(1).lower() if m else ""
    def name(r):
        m = re.search(r'NAME="([^"]+)"', r)
        return m.group(1).lower() if m else ""
    want = (language or "").lower()
    checks = (
        lambda r: name(r).endswith("original"),
        lambda r: want and (lang(r) == want or lang(r).split("-")[0] == want.split("-")[0]) and "dubbed" not in name(r),
        lambda r: "DEFAULT=YES" in r,
        lambda r: "dubbed" not in name(r) and "AUTOSELECT=YES" in r,
        lambda r: "dubbed" not in name(r),
    )
    for check in checks:
        hit = [r for r in renditions if check(r)]
        if hit:
            return hit[:1]
    return renditions[:1]


def reduce_manifest(master_url, max_height=MAX_HEIGHT, language=None):
    """One H.264 video variant + its audio rendition: fast startup, broad decode support."""
    with urllib.request.urlopen(master_url, timeout=10) as response:
        lines = response.read().decode().splitlines()
    media = [line for line in lines if line.startswith("#EXT-X-MEDIA:")]
    variants = []
    for index, line in enumerate(lines):
        if line.startswith("#EXT-X-STREAM-INF:") and index + 1 < len(lines):
            res = re.search(r"RESOLUTION=\d+x(\d+)", line)
            codecs = re.search(r'CODECS="([^"]+)"', line)
            audio = re.search(r'AUDIO="([^"]+)"', line)
            bandwidth = re.search(r"BANDWIDTH=(\d+)", line)
            variants.append({
                "inf": line, "uri": lines[index + 1],
                "height": int(res.group(1)) if res else 0,
                "codecs": codecs.group(1) if codecs else "",
                "audio": audio.group(1) if audio else None,
                "bandwidth": int(bandwidth.group(1)) if bandwidth else 0,
            })
    if not variants:
        return "\n".join(lines) + "\n", 0
    fitting = [v for v in variants if v["height"] <= max_height]
    h264 = [v for v in fitting if v["codecs"].startswith("avc1")]
    best = max(h264 or fitting or variants, key=lambda v: (v["height"], v["bandwidth"]))
    group = [m for m in media if best["audio"] and f'GROUP-ID="{best["audio"]}"' in m]
    text = "#EXTM3U\n#EXT-X-INDEPENDENT-SEGMENTS\n"
    text += "".join(line + "\n" for line in pick_audio(group, language))
    text += best["inf"] + "\n" + best["uri"] + "\n"
    return text, best["height"]


def stop_previous_server():
    try:
        pid = int(SERVER_PID.read_text())
        os.kill(pid, signal.SIGTERM)
    except (OSError, ValueError):
        pass


def serve(manifest_text):
    """Fork a loopback-only HTTP server for one manifest; returns its URL.

    QtMultimedia only lets HLS fetch https segments when the master playlist
    itself came from http(s); a local file is restricted to file/crypto/data.
    """
    stop_previous_server()
    token = secrets.token_urlsafe(12)
    body = manifest_text.encode()
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    sock.bind(("127.0.0.1", 0))
    sock.listen(8)
    port = sock.getsockname()[1]
    if os.fork() == 0:
        os.setsid()
        if os.fork() != 0:
            os._exit(0)
        devnull = os.open(os.devnull, os.O_RDWR)
        for fd in (0, 1, 2):
            os.dup2(devnull, fd)
        SERVER_PID.write_text(str(os.getpid()))
        last = [time.time()]

        class Handler(http.server.BaseHTTPRequestHandler):
            def do_GET(self):
                last[0] = time.time()
                if self.path != f"/{token}.m3u8":
                    self.send_error(404)
                    return
                self.send_response(200)
                self.send_header("Content-Type", "application/vnd.apple.mpegurl")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)

            def log_message(self, *args):
                pass

        server = http.server.ThreadingHTTPServer(("127.0.0.1", port), Handler, bind_and_activate=False)
        server.socket.close()
        server.socket = sock
        threading.Thread(target=server.serve_forever, daemon=True).start()
        while time.time() - last[0] < SERVER_IDLE_SECONDS:
            time.sleep(5)
        os._exit(0)
    sock.close()
    os.wait()
    return f"http://127.0.0.1:{port}/{token}.m3u8"


def resolve(url, fresh=False):
    info = extract(url, fresh)
    try:
        text, height = reduce_manifest(info["manifest"], language=info.get("language"))
    except Exception:
        if fresh:
            raise
        info = extract(url, fresh=True)
        text, height = reduce_manifest(info["manifest"], language=info.get("language"))
    entry = history_entry(info["id"])
    return {
        "ok": True, "id": info["id"], "url": watch_url(info["id"]),
        "title": info["title"], "artist": info["artist"], "duration": info["duration"],
        "live": info["live"], "height": height, "source": serve(text),
        "resume": resume_position(entry),
    }


# ---------------------------------------------------------------- history

def load_history():
    data = read_json(HISTORY, [])
    return data if isinstance(data, list) else []


def history_entry(vid):
    return next((e for e in load_history() if e.get("id") == vid), None)


def resume_position(entry):
    if not entry or entry.get("finished"):
        return 0
    return max(0, float(entry.get("position") or 0))


def history_update(item):
    vid = video_id(item.get("url") or "") or video_id(item.get("id") or "")
    if not vid:
        raise ValueError("History update needs a YouTube id or url")
    position = max(0.0, float(item.get("position") or 0))
    length = max(0.0, float(item.get("length") or 0))
    history = load_history()
    old = next((e for e in history if e.get("id") == vid), {})
    finished = length > 0 and position >= length - FINISHED_MARGIN
    entry = {
        "id": vid, "url": watch_url(vid),
        "title": item.get("title") or old.get("title") or "Unknown",
        "artist": item.get("artist") or old.get("artist") or "",
        "length": length or old.get("length") or 0,
        "position": 0 if finished else position,
        "finished": finished,
        "updated": int(time.time()),
    }
    history = [entry] + [e for e in history if e.get("id") != vid]
    write_json(HISTORY, history[:HISTORY_LIMIT])
    return entry


# ---------------------------------------------------------------- floating window

def mpv_request(command, timeout=2):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(timeout)
        client.connect(str(PIP_SOCK))
        client.sendall((json.dumps({"command": command, "request_id": 7}) + "\n").encode())
        buffer = b""
        while True:
            chunk = client.recv(65536)
            if not chunk:
                return None
            buffer += chunk
            while b"\n" in buffer:
                line, buffer = buffer.split(b"\n", 1)
                reply = json.loads(line)
                if reply.get("request_id") == 7:
                    return reply.get("data") if reply.get("error") == "success" else None


def pip_status():
    state = read_json(PIP_STATE, {})
    pid = state.get("pid")
    alive = False
    if pid:
        try:
            os.kill(pid, 0)
            alive = Path(f"/proc/{pid}/cmdline").read_bytes().startswith(b"mpv")
        except OSError:
            alive = False
    state["running"] = alive
    if alive:
        try:
            state["position"] = mpv_request(["get_property", "time-pos"]) or state.get("position", 0)
            state["paused"] = mpv_request(["get_property", "pause"]) is True
        except OSError:
            pass
    return state


def pip_pids():
    """Every floating-window mpv, including strays from a lost IPC socket."""
    pids = []
    for proc in Path("/proc").iterdir():
        if proc.name.isdigit():
            try:
                args = (proc / "cmdline").read_bytes().split(b"\0")
            except OSError:
                continue
            if args and args[0].endswith(b"mpv") and b"--wayland-app-id=omatainment-pip" in args:
                pids.append(int(proc.name))
    return pids


def pip_close():
    state = pip_status()
    if state.get("running"):
        try:
            mpv_request(["quit"])
        except OSError:
            pass
    for pid in pip_pids():
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    for _ in range(30):
        if not pip_pids():
            break
        time.sleep(0.1)
    for pid in pip_pids():
        os.kill(pid, signal.SIGKILL)
    return state


def pip(url, title, artist, start):
    pip_close()
    vid = video_id(url)
    if not vid:
        raise ValueError("Not a YouTube video URL")
    entry = history_entry(vid) or {}
    start = float(start or 0) or resume_position(entry)
    title = title or entry.get("title") or "YouTube video"
    volume = os.environ.get("OMATAINMENT_PIP_VOLUME") or read_json(STATE / "preferences.json", {}).get("videoVolume", 80)
    PIP_SOCK.unlink(missing_ok=True)
    # mpv's own yt-dlp hook handles DASH/HLS selection and accurate resume seeks.
    process = subprocess.Popen(
        ["mpv", "--wayland-app-id=omatainment-pip", "--force-window=immediate", "--no-terminal",
         "--keep-open=no", "--idle=no", f"--start={max(0, start):.1f}", f"--volume={volume}",
         "--ytdl-format=bv*[height<=1080][vcodec^=avc1]+ba[format_note*=original]/bv*[height<=1080][vcodec^=avc1]+ba/bv*[height<=1080]+ba/b",
         "--audio-client-name=OmaTainmentVideo", f"--force-media-title={title}",
         f"--title=OmaTainment · {title}", f"--input-ipc-server={PIP_SOCK}",
         "--autofit=640x360", watch_url(vid)],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    meta = {"pid": process.pid, "id": vid, "url": watch_url(vid), "title": title,
            "artist": artist or entry.get("artist") or "", "length": entry.get("length") or 0,
            "position": start, "started": int(time.time())}
    write_json(PIP_STATE, meta)
    # Detached tracker keeps continue-watching current while the window lives.
    if os.fork() == 0:
        os.setsid()
        if os.fork() != 0:
            os._exit(0)
        devnull = os.open(os.devnull, os.O_RDWR)
        for fd in (0, 1, 2):
            os.dup2(devnull, fd)
        track(meta)
        os._exit(0)
    os.wait()
    return {"ok": True, "pip": meta}


def track(meta):
    last = meta["position"]
    while True:
        try:
            os.kill(meta["pid"], 0)
        except OSError:
            break
        try:
            position = mpv_request(["get_property", "time-pos"])
            length = mpv_request(["get_property", "duration"])
            if isinstance(position, (int, float)):
                last = position
                history_update({**meta, "position": position, "length": length or meta["length"]})
                current = read_json(PIP_STATE, {})
                if current.get("pid") == meta["pid"]:
                    write_json(PIP_STATE, {**current, "position": position})
        except (OSError, ValueError):
            pass
        time.sleep(2)
    history_update({**meta, "position": last, "length": meta["length"]})
    current = read_json(PIP_STATE, {})
    if current.get("pid") == meta["pid"]:
        write_json(PIP_STATE, {**current, "position": last, "closed": int(time.time())})


# ---------------------------------------------------------------- main

def main(argv):
    command = argv[1] if len(argv) > 1 else "history"
    args = argv[2:]
    try:
        if command == "resolve":
            out(resolve(args[0], fresh="--fresh" in args))
        elif command == "prefetch":
            if os.fork() == 0:
                os.setsid()
                devnull = os.open(os.devnull, os.O_RDWR)
                for fd in (0, 1, 2):
                    os.dup2(devnull, fd)
                try:
                    extract(args[0])
                finally:
                    os._exit(0)
            out({"ok": True})
        elif command == "history":
            out({"ok": True, "items": load_history()})
        elif command == "history-update":
            out({"ok": True, "entry": history_update(json.loads(args[0]))})
        elif command == "history-remove":
            write_json(HISTORY, [e for e in load_history() if e.get("id") != args[0]])
            out({"ok": True, "items": load_history()})
        elif command == "pip":
            out(pip(args[0], args[1] if len(args) > 1 else "", args[2] if len(args) > 2 else "",
                    args[3] if len(args) > 3 else 0))
        elif command == "pip-pause":
            if pip_status().get("running"):
                mpv_request(["set_property", "pause", True])
            out({"ok": True})
        elif command == "pip-close":
            out({"ok": True, "pip": pip_close()})
        elif command == "pip-status":
            out({"ok": True, "pip": pip_status()})
        elif command == "youtube":
            vid = video_id(args[0])
            if not vid:
                raise ValueError("Not a YouTube video URL")
            start = int(float(args[1])) if len(args) > 1 and args[1] else int(resume_position(history_entry(vid)))
            target = watch_url(vid) + (f"&t={start}s" if start > 0 else "")
            subprocess.Popen(["omarchy-launch-browser", target], stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            out({"ok": True, "url": target})
        else:
            out({"ok": False, "error": f"Unknown command: {command}"})
            return 2
    except Exception as error:  # surfaced to the panel as a readable message
        out({"ok": False, "error": str(error) or error.__class__.__name__})
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
